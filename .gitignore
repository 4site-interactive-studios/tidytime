# --- Secrets & machine-local config (NEVER commit — guardrail G6) ---
config.json
Local.xcconfig
# NOTE: do NOT use a bare `secrets*` here — under macOS's case-insensitive git matching it also
# ignores source files like SecretStore.swift ("secretstore" begins with "secrets"). Be specific:
secrets.json
secrets.yaml
secrets.txt
.secrets/
*.pem
*.p12

# --- Generated Xcode project (produced by XcodeGen) ---
TidyTime.xcodeproj/

# --- Build output ---
.build/
# Anchored to the repo root. Unanchored `build/` also matched `docs/build/`, so four setup guides
# (signing-and-tcc, environment-setup, testing-strategy, xcodegen-spec — 931 lines) were silently
# excluded from every clone and every doc link into them was broken.
/build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint

# --- App runtime data / local database (never commit user data) ---
*.sqlite
*.sqlite-wal
*.sqlite-shm
outbound-payloads*.log
*.log

# --- macOS ---
.DS_Store

# --- SwiftPM local caches ---
.swiftpm/xcode/

# --- Packaged output (make dmg) ---
dist/
